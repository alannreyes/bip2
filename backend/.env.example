# Application
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001

# ===========================================
# SECURITY SETTINGS
# ===========================================

# AUTH_ENABLED: Habilitar autenticación global
# - false (default): Todos los endpoints son públicos
# - true: Requiere autenticación según AUTH_MODE
AUTH_ENABLED=false

# AUTH_MODE: Modo de autenticación (solo cuando AUTH_ENABLED=true)
# - jwt: Solo acepta tokens JWT (Bearer token)
# - api-key: Solo acepta API Keys (header X-API-Key)
# - both (default): Acepta JWT o API Key
AUTH_MODE=both

# SWAGGER_ENABLED: Habilitar documentación Swagger
# - true (default): Swagger disponible en /api/docs
# - false: Swagger deshabilitado (recomendado en producción)
SWAGGER_ENABLED=true

# ===========================================
# DATABASE
# ===========================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-secure-password-here
DATABASE_NAME=qdrant_catalog_sync

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=your-qdrant-api-key

# ===========================================
# EXTERNAL APIS
# ===========================================
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_EMBEDDING_DELAY_MS=600

# OpenAI API (usado para filtro RTI en búsquedas con LLM)
OPENAI_API_KEY=your-openai-api-key-here

# ===========================================
# AUTHENTICATION (Solo cuando AUTH_ENABLED=true)
# ===========================================

# JWT Configuration
# Generar con: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Microsoft Entra ID (Azure AD) - Opcional
# Configurar solo si usarás login con Office 365
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
AZURE_AD_REDIRECT_URI=http://localhost:3001/api/auth/callback

# ===========================================
# CORS
# ===========================================
CORS_ORIGIN=http://localhost:3000
