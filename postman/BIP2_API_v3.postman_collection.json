    {
      "name": "Search",
      "item": [
        {
          "name": "Búsqueda por Texto",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"collections\": [\"catalogo_stock\"],\n  \"query\": \"LLAVE MIXTA 13MM\",\n  \"limit\": 10\n}"
            },
            "url": "{{base_url}}/search/text"
          }
        },
        {
          "name": "Búsqueda con minRelevancia 0.70",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"collections\": [\"catalogo_stock\"],\n  \"query\": \"LLAVE MIXTA 13MM\",\n  \"limit\": 10,\n  \"minRelevancia\": 0.70,\n  \"useLLMFilter\": true\n}"
            },
            "url": "{{base_url}}/search/text"
          }
        },
        {
          "name": "Búsqueda con filtro Marca",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"collections\": [\"catalogo_stock\"],\n  \"query\": \"TALADRO\",\n  \"limit\": 10,\n  \"marca\": \"TRUPER\"\n}"
            },
            "url": "{{base_url}}/search/text"
          }
        },
        {
          "name": "Búsqueda Vectorial Raw",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"collections\": [\"catalogo_stock\"],\n  \"query\": \"DESTORNILLADOR PLANO\",\n  \"limit\": 5\n}"
            },
            "url": "{{base_url}}/search/raw-vectorial"
          }
        }
      ]
    },
    {
      "name": "Duplicates - Compare",
      "item": [
        {
          "name": "Compare - Solo Embeddings",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descripcion1\": \"LLAVE MIXTA 13MM TRUPER\",\n  \"descripcion2\": \"LLAVE COMBINADA 13 MILIMETROS TRUPER\",\n  \"useLLMFilter\": false\n}"
            },
            "url": "{{base_url}}/duplicates/compare",
            "description": "Rápido (~1.3s) - Similarity: 92.2%"
          }
        },
        {
          "name": "Compare - Embeddings + LLM",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descripcion1\": \"LLAVE MIXTA 13MM TRUPER\",\n  \"descripcion2\": \"LLAVE COMBINADA 13 MILIMETROS TRUPER\",\n  \"useLLMFilter\": true\n}"
            },
            "url": "{{base_url}}/duplicates/compare",
            "description": "Preciso pero más lento - incluye clasificación RTI"
          }
        },
        {
          "name": "Compare - Diferente Marca",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descripcion1\": \"LLAVE STILLSON 18 PULGADAS\",\n  \"descripcion2\": \"LLAVE STILLSON 18 PULGADAS\",\n  \"marca1\": \"TRUPER\",\n  \"marca2\": \"STANLEY\",\n  \"useLLMFilter\": true\n}"
            },
            "url": "{{base_url}}/duplicates/compare",
            "description": "Esperado: SUSTITUTO_PERFECTO (0.85)"
          }
        },
        {
          "name": "Compare - Productos Relacionados",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descripcion1\": \"TALADRO ROTOMARTILLO 1/2 DEWALT\",\n  \"descripcion2\": \"BROCA PARA CONCRETO 1/2 X 6 TRUPER\",\n  \"useLLMFilter\": true\n}"
            },
            "url": "{{base_url}}/duplicates/compare",
            "description": "Esperado: RELACIONADO (0.30)"
          }
        },
        {
          "name": "Compare - Irrelevantes",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descripcion1\": \"LLAVE MIXTA 13MM TRUPER\",\n  \"descripcion2\": \"PINTURA VINILICA BLANCA 19L\",\n  \"useLLMFilter\": true\n}"
            },
            "url": "{{base_url}}/duplicates/compare",
            "description": "Esperado: IRRELEVANTE o RECHAZADO"
          }
        }
      ]
    },
    {
      "name": "Duplicates - Detection",
      "item": [
        {
          "name": "Detectar Duplicados",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"collection\": \"catalogo_stock\",\n  \"similarityThreshold\": 0.95,\n  \"limit\": 20\n}"
            },
            "url": "{{base_url}}/duplicates/detect"
          }
        },
        {
          "name": "Detectar con AI Classification",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"collection\": \"catalogo_stock\",\n  \"similarityThreshold\": 0.90,\n  \"limit\": 10,\n  \"useAiClassification\": true\n}"
            },
            "url": "{{base_url}}/duplicates/detect"
          }
        },
        {
          "name": "Validar Si Existe",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"collection\": \"catalogo_stock\",\n  \"descripcion\": \"LLAVE MIXTA 13MM TRUPER\",\n  \"similarityThreshold\": 0.85\n}"
            },
            "url": "{{base_url}}/duplicates/validate-exists"
          }
        },
        {
          "name": "Validar con Marca y Modelo",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"collection\": \"catalogo_stock\",\n  \"descripcion\": \"LLAVE STILLSON 18 PULGADAS\",\n  \"marca\": \"TRUPER\",\n  \"modelo\": \"15839\",\n  \"similarityThreshold\": 0.85\n}"
            },
            "url": "{{base_url}}/duplicates/validate-exists"
          }
        },
        {
          "name": "Obtener Filter Values",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/duplicates/filter-values?collection=catalogo_stock",
              "host": ["{{base_url}}"],
              "path": ["duplicates", "filter-values"],
              "query": [{"key": "collection", "value": "catalogo_stock"}]
            }
          }
        },
        {
          "name": "Reporte de Duplicados",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/duplicates/report?collection=catalogo_stock",
              "host": ["{{base_url}}"],
              "path": ["duplicates", "report"],
              "query": [{"key": "collection", "value": "catalogo_stock"}]
            }
          }
        }
      ]
