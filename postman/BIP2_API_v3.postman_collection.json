    {
      "name": "Prompts (Admin - Auth Required)",
      "item": [
        {
          "name": "Listar Prompts",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "url": "{{base_url}}/prompts"
          }
        },
        {
          "name": "Obtener Prompt Activo",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "url": "{{base_url}}/prompts/filter_search_results"
          }
        },
        {
          "name": "Historial de Prompt",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "url": "{{base_url}}/prompts/filter_search_results/history"
          }
        },
        {
          "name": "Crear Draft de Prompt",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"filter_search_results\",\n  \"content\": \"Tu nuevo prompt aquí...\",\n  \"changeDescription\": \"Descripción del cambio\"\n}"
            },
            "url": "{{base_url}}/prompts"
          }
        },
        {
          "name": "Probar Prompt",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"LLAVE MIXTA 13MM\",\n  \"products\": [\n    {\"id\": \"1\", \"descripcion\": \"LLAVE COMBINADA 13MM\", \"marca\": \"TRUPER\"},\n    {\"id\": \"2\", \"descripcion\": \"LLAVE MIXTA 14MM\", \"marca\": \"TRUPER\"}\n  ]\n}"
            },
            "url": "{{base_url}}/prompts/:promptId/test",
            "description": "Reemplazar :promptId con UUID del prompt"
          }
        },
        {
          "name": "Activar Prompt",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "url": "{{base_url}}/prompts/:promptId/activate",
            "description": "Reemplazar :promptId con UUID del prompt"
          }
        },
        {
          "name": "Rollback Prompt",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": 1\n}"
            },
            "url": "{{base_url}}/prompts/filter_search_results/rollback"
          }
        },
        {
          "name": "Reset a Default",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "url": "{{base_url}}/prompts/filter_search_results/reset"
          }
        }
      ]
    }
  ]
