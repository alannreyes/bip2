            },
            "url": {
              "raw": "http://192.168.40.197:3001/api/duplicates/analyze-product",
              "protocol": "http",
              "host": ["192.168.40.197"],
              "port": "3001",
              "path": ["api", "duplicates", "analyze-product"]
            },
            "description": "Busca solo duplicados casi identicos (95%+ similitud)."
