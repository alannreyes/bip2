              "raw": "{\n  \"descripcion1\": \"LLAVE MIXTA 13MM\",\n  \"descripcion2\": \"LLAVE MIXTA 13MM\",\n  \"marca1\": \"STANLEY\",\n  \"marca2\": \"TRUPER\"\n}"
            },
            "url": {
              "raw": "http://192.168.40.197:3001/api/duplicates/compare",
