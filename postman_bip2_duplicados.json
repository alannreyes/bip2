            },
            "url": {
              "raw": "http://192.168.40.197:3001/api/duplicates/analyze-product",
              "protocol": "http",
              "host": ["192.168.40.197"],
              "port": "3001",
              "path": ["api", "duplicates", "analyze-product"]
            },
            "description": "Busca productos relacionados con umbral bajo.\n\nUtil para encontrar:\n- Productos de la misma familia\n- Variantes o complementos\n- Productos que podrian agruparse"
          }
