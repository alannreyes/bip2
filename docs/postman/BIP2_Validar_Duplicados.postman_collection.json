						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"collection\": \"catalogo_stock\",\n  \"descripcion\": \"ESCOBILLA DE HIERRO CON MANGO DE MADERA\",\n  \"similarityThreshold\": 0.85\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/duplicates/validate-exists",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"duplicates",
								"validate-exists"
							]
						},
						"description": "## Caso: Localismo Perú/España\n\n\"HIERRO\" (España) = \"FIERRO\" (Perú).\n\n### Resultado esperado:\n- Detecta como duplicado de `ESCOBILLA DE FIERRO MANGO MADERA`"
					},
					"response": []
				},
				{
					"name": "7. Variante de color",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"collection\": \"catalogo_stock\",\n  \"descripcion\": \"CINTURON DE SEGURIDAD 2 PUNTAS COLOR ROJO\",\n  \"similarityThreshold\": 0.85\n}",
							"options": {
